#
# ESP32 options
#
# Re-enable OPTIMIZATION_PERF when these bugs are fixed:
# https://github.com/espressif/arduino-esp32/issues/9784
# https://github.com/espressif/arduino-esp32/issues/9607
#CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_ESP32_XTAL_FREQ_AUTO=y
# El encoder JPEG por software iba a 160 MHz; a 240 MHz rinde +50%
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Dos slots de app para habilitar OTA (WiFi)
CONFIG_PARTITION_TABLE_TWO_OTA=y

# Bluetooh related
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
# El mando FF01 es Bluetooth Clasico (BR/EDR): BLE solo gasta RAM.
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
# Should be, at least, one more than CONFIG_BLUEPAD32_MAX_DEVICES
# See: https://gitlab.com/ricardoquesada/bluepad32/-/issues/11
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BTDM_CTRL_BLE_MAX_CONN=5
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=n

CONFIG_ESP_COREDUMP_ENABLE=n

# MBEDTLS
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=y

# Ahorro de flash (~110 KB): el bundle de certificados y las curvas ECP
# son lo que mas pesa. Con todo activado el binario no cabe en el slot OTA
# de 1,5 MB (1.572.864 B) y el robot no puede actualizarse.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_MAX_CERTS=3
CONFIG_MBEDTLS_ERROR_STRINGS=n
# Solo las curvas que usan GitHub y Let's Encrypt
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n

#
# FreeRTOS
#
# Enable FreeRTOS stats formatting functions, needed for 'tasks' console command
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n
# Needed for ArduinoCore v2.0.5
CONFIG_FREERTOS_HZ=1000

# ESP-IDF 5.5 uses more memory than previous versions, increate task size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

#
# Bluepad32 Options
#
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_MAX_DEVICES=1
# Arduino Serial conflicts with the console
# To disable replace "y" with "n"
CONFIG_BLUEPAD32_USB_CONSOLE_ENABLE=n
# Brings too many issues with Arduino users. Disable it by default.
# Can be enabled via API.
CONFIG_BLUEPAD32_ENABLE_VIRTUAL_DEVICE_BY_DEFAULT=n

#
# Arduino Options
#
CONFIG_AUTOSTART_ARDUINO=n
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_BLE=n
CONFIG_ARDUINO_SELECTIVE_BluetoothSerial=n
# Complains about missing ESP-SR header when compiling on esp32-s3. Temporary disabled
CONFIG_ARDUINO_SELECTIVE_ESP_SR=n
# Cannot disable SimpleBLE since it is included from WiFiProv.cpp
#CONFIG_ARDUINO_SELECTIVE_SimpleBLE=n

#
# BTstack
#
# Needs to be disabled for ESP32-C6
# See: https://github.com/bluekitchen/btstack/issues/599
#
CONFIG_BTSTACK_AUDIO=n

#
# IRAM: WiFi+BT+OTA+Arduino overflowed IRAM0 by ~14 KB.
# Move WiFi/FreeRTOS code out of IRAM into flash.
#
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

#
# PSRAM: la camara guarda los fotogramas en PSRAM (el modulo tiene 4 MB)
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_AUTO=y
# 40 MHz: el 80M da mas ancho de banda al encoder JPEG, pero se sospecha
# inestable en este modulo (candidato al bucle de arranque de v1.4)
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

#
# Optimizacion -Os: con el build de debug (-Og) se desborda la IRAM0
#
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_DEFAULT is not set
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set

#
# DRAM: camara + WiFi + BT desbordaron dram0_0_seg por ~5.8 KB.
# Menos buffers estaticos de WiFi.
#
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Sin strings de log: con WARN el binario se pasa del slot OTA de 1,5 MB
# (v1.4 = 1.579.488 B > 1.572.864 B y el robot no puede actualizarse)
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_MAXIMUM_LEVEL=0
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
